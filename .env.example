# Copy to .env and fill in. .env is gitignored - never commit real credentials.

# Blynk device auth token (Blynk console > Device > Device Info)
BLYNK_TOKEN=your-blynk-auth-token

# PostgreSQL
POSTGRES_USER=user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=data

# Ollama chat model pulled on startup
OLLAMA_MODEL=falcon3:1b
